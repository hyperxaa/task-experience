# Local default. In production use /var/lib/taskxp/taskxp.db.
DATABASE_URL=./data/taskxp.db

# 32 random bytes encoded as 64 hex characters; generate with: openssl rand -hex 32
# Used as a pepper for Argon2id password and animal-code hashes. Keep stable.
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Required only for first production setup; remove after setup.
TASK_XP_SETUP_TOKEN=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_CHARACTERS

# Public browser origin. Include scheme and port if non-standard; no trailing path.
PUBLIC_ORIGIN=http://127.0.0.1:5191

PORT=5191
# Local-only default. On erik set the LAN IP so mark can connect, then firewall 5191 to mark.
HOST=127.0.0.1
TASK_XP_TRUST_PROXY=false
NODE_ENV=development
